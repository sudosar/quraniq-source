  "deduction": {
    "title": "The City Turned Upside Down",
    "intro": "In a valley steeped in corruption, one faithful soul stood alone against the tide. Tasked with calling a defiant community back to purity, this figure faced mockery, threats, and ultimate destruction descending from the sky.",
    "clues": [
      "I was sent as a messenger to a community that transgressed all bounds.",
      "I warned my people about an immorality that no nation before them had committed.",
      "I offered guidance in purity, but my people mocked me and demanded punishment instead.",
      "I prayed to Allah for help against my corrupt people when they threatened to expel me.",
      "Angels came to me in the form of guests, and I feared for them because of my people.",
      "I was commanded to leave by night with my followers, and stones of baked clay rained upon those left behind."
    ],
    "categories": {
      "identity": {
        "label": "Who Am I?",
        "options": [
          "Prophet Shuayb",
          "Prophet Lut",
          "Prophet Idris",
          "Prophet Salih",
          "Prophet Hud"
        ],
        "answer": "Prophet Lut"
      },
      "trial": {
        "label": "What Was The Crime Of My People?",
        "options": [
          "Hamstringing the she-camel of Allah",
          "Committing shameful immorality unknown to any nation before",
          "Building lofty towers out of arrogance",
          "Worshipping the golden calf in absence of their leader",
          "Withholding measure and weight in trade"
        ],
        "answer": "Committing shameful immorality unknown to any nation before"
      },
      "location": {
        "label": "What Was Sent Against The Transgressors?",
        "options": [
          "A flood that covered the mountaintops",
          "Stones of baked clay marked by your Lord",
          "A mighty blast that seized them at sunrise",
          "Birds carrying stones against an army with elephants",
          "A swarm of locusts, lice and frogs"
        ],
        "answer": "Stones of baked clay marked by your Lord"
      },
      "outcome": {
        "label": "What Was My Final Outcome?",
        "options": [
          "I was raised alive to the heavens",
          "I was swallowed by a great fish then forgiven",
          "I was thrown into fire that became cool and safe",
          "I was saved with my followers except my spouse who was left behind",
          "I slept in a cave for many years"
        ],
        "answer": "I was saved with my followers except my spouse who was left behind"
      }
    },
    "verseRef": "51:35",
    "arabic": "فَأَخْرَجْنَا مَن كَانَ فِيهَا مِنَ ٱلْمُؤْمِنِينَ",
    "verse": "So We brought out whoever was in them [i.e., the cities] of the believers. (51:35)"
  },
